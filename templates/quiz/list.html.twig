{% extends 'base.html.twig' %}

{% block title %}Liste des quiz{% endblock %}

{% block body %}
    {% if quizList is empty %}
        <div role="alert" class="alert alert-warning mt-5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span>Vous n'avez créé aucun quiz pour le moment ! <a href="{{ path('quiz_new') }}" class="link link-primary hover:link-info">Créer un quiz ?</a></span>
        </div>
    {% else %}
        <div class="overflow-x-auto rounded-box border-4 border-base-content/5 bg-base-100 mt-5">
            <table class="table">

                <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Date de création</th>
                        <th>NB questions</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                {% for quiz in quizList %}
                    <tr>
                        <td>{{ quiz.title|capitalize }}</td>
                        <td>{{ quiz.createdAt|date('d/m/Y H:i') }}</td>
                        <td>{{ quiz.questions|length }}</td>
                        <td>
                            <div class="flex gap-2 justify-end">
                                <a href="#" class="btn btn-sm btn-success">Lancer</a>

                                <a href="{{ path('quiz_update', {'quiz': quiz.id}) }}" class="btn btn-sm btn-info">Modifier</a>

                                <form method="post" action="{{ path('quiz_delete', {'quiz': quiz.id}) }}" onsubmit="return confirm('Es-tu sûr de vouloir supprimer ce quiz et toutes ses questions ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ quiz.id) }}">
                                    <button class="btn btn-sm btn-error">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>

            </table>
        </div>

    {% endif %}

{% endblock %}

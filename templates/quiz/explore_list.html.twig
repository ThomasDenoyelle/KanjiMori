{% extends 'base.html.twig' %}

{% block title %}Explorer les quiz - {{ app_name|default('Kanji App') }}{% endblock %}

{% block body %}
    <div class="flex flex-col items-center w-full min-h-[70vh] p-4 lg:p-8">
        <div class="w-full max-w-7xl flex flex-col gap-8">

            <div class="flex flex-col gap-2 text-center sm:text-left">
                <h1 class="text-4xl font-bold flex items-center gap-3 justify-center sm:justify-start">
                    <i class="fa-solid fa-globe text-primary"></i> Quiz de la communauté
                </h1>
                <p class="text-base-content/70 text-lg">Découvre et joue aux quiz créés par la communauté !</p>
            </div>

            <div class="divider mt-0"></div>

            {% if quizList is empty %}
                <div class="alert alert-info shadow-sm max-w-2xl mx-auto mt-4">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span>Il n'y a aucun quiz public pour le moment. Reviens un peu plus tard !</span>
                </div>
            {% else %}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

                    {% for quiz in quizList %}
                        <div class="card bg-base-300 shadow-xl border border-base-200 hover:border-primary/50 transition-colors flex flex-col">
                            <div class="card-body p-6 flex flex-col grow">

                                <h2 class="card-title text-2xl mb-1">{{ quiz.title|capitalize }}</h2>

                                <div class="flex items-center gap-3">
                                    <div class="avatar">
                                        <div class="w-8 h-8 rounded-full ring ring-primary/30 ring-offset-base-300 ring-offset-2">
                                            {% if quiz.author.avatar %}
                                                <img src="{{ vich_uploader_asset(quiz.author, 'avatarFile') }}" alt="Avatar de {{ quiz.author.firstname }}" />
                                            {% else %}
                                                <img src="https://ui-avatars.com/api/?name={{ quiz.author.firstname }}+{{ quiz.author.lastname }}&background=random" alt="Avatar par défaut" />
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="text-sm font-medium text-base-content/80">
                                        <a href="{{ path('user_profil', {'user': quiz.author.id}) }}" class="link link-hover">
                                            {{ quiz.author.firstname }} {{ quiz.author.lastname|first }}.
                                        </a>
                                    </div>
                                </div>

                                <div class="flex justify-between items-center text-sm text-base-content/60 mt-auto pt-2 border-t border-base-content/10">
                                    <button type="button" onclick="document.getElementById('questions_modal_{{ quiz.id }}').showModal()" class="badge badge-outline badge-sm font-medium gap-1 hover:bg-base-200 hover:border-primary transition-colors cursor-pointer">
                                        <i class="fa-solid fa-clipboard-question text-primary"></i>
                                        {{ quiz.questions|length }} question{{ quiz.questions|length > 1 ? 's' : '' }}
                                        <i class="fa-solid fa-eye ml-1 opacity-50 text-xs"></i>
                                    </button>
                                    <span class="text-sm">{{ quiz.createdAt|date('d/m/Y', 'Europe/Paris') }}</span>
                                </div>

                                <div class="card-actions justify-end mt-4">
                                    <a href="{{ path('game_study', {'quiz': quiz.id}) }}" class="btn btn-sm btn-primary w-full">
                                        <i class="fa-solid fa-graduation-cap"></i>
                                        Étudier
                                    </a>
                                    <a href="{{ path('game_setup', {'quiz': quiz.id}) }}" class="btn btn-success btn-sm w-full">
                                        <i class="fa-solid fa-play"></i> Jouer
                                    </a>
                                </div>

                            </div>
                        </div>

                        <dialog id="questions_modal_{{ quiz.id }}" class="modal modal-bottom sm:modal-middle">
                            <div class="modal-box w-11/12 max-w-2xl">
                                <h3 class="font-bold text-2xl mb-4 flex items-center gap-3">
                                    <i class="fa-solid fa-list text-primary"></i> Contenu du quiz
                                </h3>

                                <p class="text-base-content/70 mb-4 font-semibold">{{ quiz.title }}</p>

                                <div class="overflow-x-auto border border-base-200 rounded-xl">
                                    <table class="table table-pin-rows w-full shadow-2xl bg-base-200">
                                        <thead class="bg-base-200">
                                        <tr>
                                            <th class="w-12">#</th>
                                            <th class="text-center">Kanji</th>
                                            <th class="text-center">Lecture</th>
                                            <th class="text-center">Traduction</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% for question in quiz.questions %}
                                            <tr>
                                                <th class="text-base-content/50">{{ loop.index }}</th>
                                                <td class="text-center">{{ question.kanji }}</td>
                                                <td class="text-center">{{ question.reading }}</td>
                                                <td class="text-center">{{ question.translation }}</td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>

                                <div class="modal-action mt-6">
                                    <a href="{{ path('game_setup', {'quiz': quiz.id}) }}" class="btn btn-primary">
                                        <i class="fa-solid fa-play"></i> Jouer à ce quiz
                                    </a>
                                    <form method="dialog">
                                        <button class="btn btn-ghost">Fermer</button>
                                    </form>
                                </div>
                            </div>

                            <form method="dialog" class="modal-backdrop">
                                <button>Fermer</button>
                            </form>
                        </dialog>

                    {% endfor %}

                </div>
            {% endif %}

        </div>
    </div>
{% endblock %}

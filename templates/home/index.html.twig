{% extends 'base.html.twig' %}

{% block title %}Accueil - {{ app_name }}{% endblock %}

{% block body %}
    <div class="flex flex-col items-center w-full min-h-[70vh] p-4 lg:p-8">
        <div class="w-full max-w-7xl flex flex-col gap-8">

            <div class="flex flex-col gap-2">
                <h1 class="text-4xl font-bold">Bonjour, {{ app.user.firstname|capitalize }} !</h1>
                <p class="text-base-content/70 text-lg">Prêt à continuer ton apprentissage aujourd'hui ?</p>
            </div>

            <div class="divider"></div>

            <div class="flex flex-col gap-4">
                <div class="flex justify-between items-end">
                    <h2 class="text-2xl font-bold flex items-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left text-primary"></i> Reprendre mes quiz en cours
                    </h2>
                    <a href="{{ path('quiz_list') }}" class="btn btn-sm btn-ghost">Voir tous les quiz</a>
                </div>

                {% if inProgressAttempts is empty %}
                    <div class="alert alert-info shadow-sm mt-2">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <span>Tu n'as aucun quiz en cours. C'est le moment d'en lancer un nouveau !</span>
                        <a href="{{ path('quiz_list') }}" class="btn btn-sm btn-primary">Jouer</a>
                    </div>
                {% else %}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-2">
                        {% for quizAttempt in inProgressAttempts %}

                            {% set currentProgress = quizAttempt.answerAttempts|length %}

                            <div class="card bg-base-300 shadow-xl border border-base-200 hover:border-primary/50 transition-colors">
                                <div class="card-body">
                                    <h3 class="card-title text-xl">
                                        {{ quizAttempt.quiz.title }}
                                        <form method="post" action="{{ path('game_delete', {'quizAttempt': quizAttempt.id}) }}" onsubmit="return confirm('Es-tu sûr de vouloir supprimer ce quiz et toutes ses questions ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ quizAttempt.id) }}">
                                            <button class="btn btn-sm btn-error btn-circle"><i class="fa-solid fa-trash-can"></i></button>
                                        </form>
                                    </h3>

                                    <div class="flex justify-between text-sm text-base-content/70 mb-2 mt-1">
                                        <span class="badge badge-outline">
                                            {{ quizAttempt.mode == 'mode_kanji' ? 'Kanji' : (quizAttempt.mode == 'mode_reading' ? 'Lecture' : 'Traduction') }}
                                        </span>
                                        <span>Lancé le {{ quizAttempt.createdAt|date('d/m', 'Europe/Paris') }}</span>
                                    </div>

                                    <div class="flex flex-col gap-1 my-4">
                                        <div class="flex justify-between text-xs font-semibold">
                                            <span>Progression</span>
                                            <span>{{ currentProgress }} / {{ quizAttempt.maxScore }}</span>
                                        </div>
                                        <progress class="progress progress-primary w-full" value="{{ currentProgress }}" max="{{ quizAttempt.maxScore }}"></progress>
                                    </div>

                                    <div class="card-actions justify-end mt-2">
                                        <a href="{{ path('game_play', {'quizAttempt': quizAttempt.id}) }}" class="btn btn-primary w-full">
                                            Continuer <i class="fa-solid fa-arrow-right ml-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

        </div>
    </div>
{% endblock %}

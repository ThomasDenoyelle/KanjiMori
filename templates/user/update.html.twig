{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil - Kanjis{% endblock %}

{% block body %}
    <div class="flex items-center justify-center w-full min-h-[70vh] p-4">

        <div class="card w-full max-w-md bg-base-300 shadow-xl">
            <div class="card-body">
                <h2 class="card-title text-2xl font-bold justify-center mb-4">Modifier mon profil</h2>

                {{ form_start(form, {'attr': {'class': 'flex flex-col items-center justify-center gap-4'}}) }}

                <fieldset class="fieldset w-full">
                    <legend class="fieldset-legend font-semibold">Prénom</legend>
                    <label class="w-full">
                        {{ form_widget(form.firstname, {'attr': {'class': 'input input-bordered w-full'}}) }}
                    </label>
                    <div class="text-error text-sm mt-1">{{ form_errors(form.firstname) }}</div>
                </fieldset>

                <fieldset class="fieldset w-full">
                    <legend class="fieldset-legend font-semibold">Nom</legend>
                    <label class="w-full">
                        {{ form_widget(form.lastname, {'attr': {'class': 'input input-bordered w-full'}}) }}
                    </label>
                    <div class="text-error text-sm mt-1">{{ form_errors(form.lastname) }}</div>
                </fieldset>

                <fieldset class="fieldset w-full">
                    <legend class="fieldset-legend font-semibold">Email</legend>
                    <label class="w-full">
                        {{ form_widget(form.email, {'attr': {'class': 'input input-bordered w-full'}}) }}
                    </label>
                    <div class="text-error text-sm mt-1">{{ form_errors(form.email) }}</div>
                </fieldset>

                <div class="w-full mt-6 flex gap-2">
                    <a href="{{ path('user_profil', {user : user.id}) }}" class="btn btn-ghost w-1/3">Annuler</a>
                    <button type="submit" class="btn btn-primary grow">Enregistrer</button>
                </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>
{% endblock %}

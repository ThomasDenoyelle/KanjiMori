{% extends 'base.html.twig' %}

{% block title %}Profil de {{ user.firstname }}{% endblock %}

{% block body %}
    <div class="flex flex-col items-center w-full min-h-[70vh] p-4 lg:p-8">
        <div class="w-full max-w-7xl grid grid-cols-1 lg:grid-cols-3 gap-8">

            <div class="lg:col-span-1 flex flex-col gap-4">
                <turbo-frame id="profile-sidebar-{{ user.id }}">
                    <div class="card w-full bg-base-300 shadow-xl border border-base-200 sticky top-4">
                        <div class="card-body items-center text-center">

                            <div class="flex flex-col items-center justify-center my-2 relative">
                                <div class="avatar">
                                    <div class="w-32 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2 shadow-lg">
                                        {% if user.avatar %}
                                            <img src="{{ vich_uploader_asset(user, 'avatarFile') }}" alt="Avatar de {{ user.firstname }}" />
                                        {% else %}
                                            <img src="https://ui-avatars.com/api/?name={{ user.firstname }}+{{ user.lastname }}&background=random&size=256" alt="Avatar par défaut" />
                                        {% endif %}
                                    </div>
                                </div>

                                {% if app.user == user %}
                                    <button class="btn btn-circle btn-sm btn-primary absolute bottom-0 right-0" onclick="avatar_modal.showModal()" title="Modifier l'avatar">
                                        <i class="fa-solid fa-camera"></i>
                                    </button>
                                {% endif %}
                            </div>

                            <h2 class="card-title text-2xl font-bold mt-2">
                                {{ user.firstname }} {{ user.lastname }}
                            </h2>

                            <div class="text-sm text-base-content/60 mb-4">
                                Membre depuis {{ user.createdAt|date('M Y') }}
                            </div>

                            <div class="flex justify-center gap-6 mb-6 w-full px-4">
                                <div class="text-center flex flex-col items-center">
                                    <span class="font-bold text-xl">{{ user.followers|length }}</span>
                                    <span class="text-xs text-base-content/70 uppercase tracking-widest font-semibold mt-1">Abonnés</span>
                                </div>
                                <div class="divider divider-horizontal mx-0"></div>
                                <div class="text-center flex flex-col items-center">
                                    <span class="font-bold text-xl">{{ user.following|length }}</span>
                                    <span class="text-xs text-base-content/70 uppercase tracking-widest font-semibold mt-1">Abonnements</span>
                                </div>
                            </div>

                            {% if app.user == user %}

                                {% if not user.verified %}
                                    <div role="alert" class="alert alert-warning alert-soft flex flex-col items-start gap-2 text-left mb-4">
                                        <div class="flex items-center gap-2">
                                            <i class="fa-solid fa-triangle-exclamation"></i>
                                            <span class="font-bold text-sm">Compte non vérifié !</span>
                                        </div>
                                        <a href="{{ path('app_resend_verify_email') }}" class="btn btn-xs btn-active w-full">
                                            Renvoyer l'email
                                        </a>
                                    </div>
                                {% else %}
                                    <div class="badge badge-success badge-soft font-bold mb-4 gap-2 py-3 px-4">
                                        <i class="fa-solid fa-check"></i> Compte vérifié
                                    </div>
                                {% endif %}

                                <div class="w-full text-left bg-base-200 p-4 rounded-xl mb-4">
                                    <p class="text-xs text-base-content/70 font-bold uppercase tracking-wider mb-1">Email</p>
                                    <p class="font-medium truncate">{{ user.email }}</p>
                                </div>

                                <a href="{{ path('user_update') }}" class="btn btn-outline btn-primary w-full">
                                    <i class="fa-solid fa-pen-to-square"></i> Modifier le profil
                                </a>

                            {% else %}

                                {% set isFollowing = user in app.user.following %}

                                <form method="post" action="{{ path('user_toggle_follow', {'targetUser': user.id}) }}" class="w-full mt-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_follow_' ~ user.id) }}">

                                    {% if isFollowing %}
                                        <button type="submit" class="btn btn-neutral w-full shadow-sm">
                                            <i class="fa-solid fa-user-check"></i> Ne plus suivre
                                        </button>
                                    {% else %}
                                        <button type="submit" class="btn btn-primary w-full shadow-sm">
                                            <i class="fa-solid fa-user-plus"></i> Suivre
                                        </button>
                                    {% endif %}
                                </form>

                            {% endif %}

                        </div>
                    </div>
                </turbo-frame>
            </div>

            <div class="lg:col-span-2 flex flex-col gap-6">
                <div class="flex items-center gap-3 bg-base-300 p-6 rounded-3xl shadow-sm border border-base-200">
                    <i class="fa-solid fa-globe text-primary text-3xl"></i>
                    <div>
                        <h2 class="text-2xl font-bold">Quiz publics</h2>
                        <p class="text-base-content/70">Les créations partagées par {{ user.firstname }}</p>
                    </div>
                </div>


                {% if publicQuizzes is empty %}
                    <div class="alert alert-info shadow-sm">
                        <i class="fa-solid fa-circle-info text-xl"></i>
                        <span>{{ user.firstname }} n'a pas encore publié de quiz public.</span>
                    </div>
                {% else %}
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        {% for quiz in publicQuizzes %}
                            <div class="card bg-base-300 shadow-sm border border-base-200 hover:border-primary/50 transition-colors">
                                <div class="card-body p-5 flex flex-col gap-3">
                                    <h3 class="card-title text-xl truncate" title="{{ quiz.title }}">
                                        {{ quiz.title }}
                                    </h3>

                                    <div class="flex items-center gap-2">
                                        <button type="button" onclick="document.getElementById('questions_modal_{{ quiz.id }}').showModal()" class="badge badge-outline badge-sm font-medium gap-1 hover:bg-base-200 hover:border-primary transition-colors cursor-pointer">
                                            <i class="fa-solid fa-clipboard-question text-primary"></i>
                                            {{ quiz.questions|length }} question{{ quiz.questions|length > 1 ? 's' : '' }}
                                            <i class="fa-solid fa-eye ml-1 opacity-50 text-xs"></i>
                                        </button>
                                    </div>

                                    <div class="card-actions justify-end mt-2 pt-2 border-t border-base-200/50">
                                        <a href="{{ path('game_setup', {'quiz': quiz.id}) }}" class="btn btn-primary btn-sm w-full">
                                            <i class="fa-solid fa-play"></i> Jouer
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <dialog id="questions_modal_{{ quiz.id }}" class="modal modal-bottom sm:modal-middle">
                                <div class="modal-box w-11/12 max-w-2xl">
                                    <h3 class="font-bold text-2xl mb-4 flex items-center gap-3">
                                        <i class="fa-solid fa-list text-primary"></i> Contenu du quiz
                                    </h3>

                                    <p class="text-base-content/70 mb-4 font-semibold">{{ quiz.title }}</p>

                                    <div class="overflow-x-auto border border-base-200 rounded-xl">
                                        <table class="table table-pin-rows w-full shadow-2xl bg-base-200">
                                            <thead class="bg-base-200">
                                            <tr>
                                                <th class="w-12">#</th>
                                                <th class="text-center">Kanji</th>
                                                <th class="text-center">Lecture</th>
                                                <th class="text-center">Traduction</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            {% for question in quiz.questions %}
                                                <tr>
                                                    <th class="text-base-content/50">{{ loop.index }}</th>
                                                    <td class="text-center">{{ question.kanji }}</td>
                                                    <td class="text-center">{{ question.reading }}</td>
                                                    <td class="text-center">{{ question.translation }}</td>
                                                </tr>
                                            {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="modal-action mt-6">
                                        <a href="{{ path('game_setup', {'quiz': quiz.id}) }}" class="btn btn-primary">
                                            <i class="fa-solid fa-play"></i> Jouer à ce quiz
                                        </a>
                                        <form method="dialog">
                                            <button class="btn btn-ghost">Fermer</button>
                                        </form>
                                    </div>
                                </div>

                                <form method="dialog" class="modal-backdrop">
                                    <button>Fermer</button>
                                </form>
                            </dialog>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

        </div>
    </div>

    {% if app.user == user %}
        <dialog id="avatar_modal" class="modal modal-bottom sm:modal-middle">
            <div class="modal-box">
                <h3 class="font-bold text-2xl mb-6 text-center">Modifier mon avatar</h3>

                {{ form_start(avatarForm) }}
                <div class="flex flex-col items-center gap-4">

                    <div class="avatar">
                        <div class="w-32 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2 shadow-lg">
                            {% if user.avatar %}
                                <img src="{{ vich_uploader_asset(user, 'avatarFile') }}" alt="Avatar actuel" />
                            {% else %}
                                <img src="https://ui-avatars.com/api/?name={{ user.firstname }}+{{ user.lastname }}&background=random&size=256" alt="Avatar par défaut" />
                            {% endif %}
                        </div>
                    </div>

                    {% if user.avatar and avatarForm.avatarFile.delete is defined %}
                        <div class="form-control mt-2">
                            <label class="btn btn-error btn-sm btn-outline cursor-pointer rounded-full px-6">
                                <i class="fa-solid fa-trash-can"></i> Supprimer l'avatar actuel
                                <div class="hidden">
                                    {{ form_widget(avatarForm.avatarFile.delete) }}
                                </div>
                            </label>
                        </div>
                    {% endif %}

                    <div class="divider my-0">Ou</div>

                    <div class="form-control w-full">
                        <label class="label">
                            <span class="label-text font-semibold">Uploader une nouvelle image</span>
                        </label>
                        {{ form_widget(avatarForm.avatarFile.file, {'attr': {'class': 'file-input file-input-bordered file-input-primary w-full shadow-sm'}}) }}
                        <div class="text-error text-sm mt-1">{{ form_errors(avatarForm.avatarFile.file) }}</div>
                    </div>

                </div>

                <div class="modal-action mt-8 border-t border-base-200 pt-6">
                    <button type="button" class="btn btn-ghost" onclick="avatar_modal.close()">Annuler</button>
                    <button type="submit" class="btn btn-primary px-8">Enregistrer</button>
                </div>
                {{ form_end(avatarForm) }}
            </div>

            <form method="dialog" class="modal-backdrop">
                <button>fermer</button>
            </form>
        </dialog>
    {% endif %}

{% endblock %}

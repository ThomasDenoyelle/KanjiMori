{% extends 'base.html.twig' %}

{% block title %}Profil de {{ user.firstname }}{% endblock %}

{% block body %}
    <div class="flex items-center justify-center w-full min-h-[70vh] p-4">

        <div class="card w-full max-w-md bg-base-300 shadow-xl">
            <div class="card-body">
                <h2 class="card-title text-2xl font-bold justify-center">
                    Profil
                    {% if app.user == user and user.verified %}
                        <a href="{{ path('user_update') }}">
                            <i class="fa-solid fa-pen-to-square text-info hover:text-primary duration-200 transition-colors"></i>
                        </a>
                    {% endif%}
                </h2>

                <div class="flex flex-col items-center justify-center my-2 relative">
                    <div class="avatar">
                        <div class="w-32 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2">
                            {% if user.avatar %}
                                <img src="{{ vich_uploader_asset(user, 'avatarFile') }}" alt="Avatar de {{ user.firstname }}" />
                            {% else %}
                                <img src="https://ui-avatars.com/api/?name={{ user.firstname }}+{{ user.lastname }}&background=random&size=256" alt="Avatar par défaut" />
                            {% endif %}
                        </div>
                    </div>

                    {% if app.user == user %}
                        <button class="btn btn-circle btn-sm btn-primary absolute bottom-0 ml-24" onclick="avatar_modal.showModal()" title="Modifier l'avatar">
                            <i class="fa-solid fa-camera"></i>
                        </button>
                    {% endif %}
                </div>

                {% if app.user == user %}
                    {% if not user.verified %}
                        <div role="alert" class="alert alert-warning alert-soft flex flex-col items-start gap-2">
                            <div class="flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                                </svg>
                                <span class="font-bold">Attention ! Votre compte n'est pas vérifié !</span>
                            </div>
                            <a href="{{ path('app_resend_verify_email') }}" class="btn btn-active w-full">
                                Renvoyer l'email de vérification
                            </a>
                        </div>
                    {% else %}
                        <div role="alert" class="alert alert-info alert-soft flex flex-col items-start gap-2">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-check"></i>
                                <span class="font-bold">Compte vérifié !</span>
                            </div>
                        </div>
                    {% endif %}
                {% endif %}

                <div class="flex flex-col items-center justify-center gap-2">
                    <fieldset class="fieldset w-full">
                        <legend class="fieldset-legend">Prénom</legend>
                        <label>
                            <input type="text" class="input w-full" value="{{ user.firstname }}" disabled/>
                        </label>
                    </fieldset>
                    <fieldset class="fieldset w-full">
                        <legend class="fieldset-legend">Nom</legend>
                        <label>
                            <input type="text" class="input w-full" value="{{ user.lastname }}" disabled/>
                        </label>
                    </fieldset>
                    <fieldset class="fieldset w-full">
                        <legend class="fieldset-legend">Email</legend>
                        <label>
                            <input type="text" class="input w-full" value="{{ user.email }}" disabled/>
                        </label>
                    </fieldset>
                </div>

            </div>
        </div>
    </div>

    {% if app.user == user %}
        <dialog id="avatar_modal" class="modal modal-bottom sm:modal-middle">
            <div class="modal-box">
                <h3 class="font-bold text-2xl mb-6 text-center">Modifier mon avatar</h3>

                {{ form_start(avatarForm) }}
                <div class="flex flex-col items-center gap-4">

                    <div class="avatar">
                        <div class="w-32 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2 shadow-lg">
                            {% if user.avatar %}
                                <img src="{{ vich_uploader_asset(user, 'avatarFile') }}" alt="Avatar actuel" />
                            {% else %}
                                <img src="https://ui-avatars.com/api/?name={{ user.firstname }}+{{ user.lastname }}&background=random&size=256" alt="Avatar par défaut" />
                            {% endif %}
                        </div>
                    </div>

                    {% if user.avatar and avatarForm.avatarFile.delete is defined %}
                        <div class="form-control mt-2">
                            <label class="btn btn-error btn-sm btn-outline cursor-pointer rounded-full px-6">
                                <i class="fa-solid fa-trash-can"></i> Supprimer l'avatar actuel
                                <div class="hidden">
                                    {{ form_widget(avatarForm.avatarFile.delete) }}
                                </div>
                            </label>
                        </div>
                    {% endif %}

                    <div class="divider my-0">Ou</div>

                    <div class="form-control w-full">
                        <label class="label">
                            <span class="label-text font-semibold">Uploader une nouvelle image</span>
                        </label>
                        {{ form_widget(avatarForm.avatarFile.file, {'attr': {'class': 'file-input file-input-bordered file-input-primary w-full shadow-sm'}}) }}
                        <div class="text-error text-sm mt-1">{{ form_errors(avatarForm.avatarFile.file) }}</div>
                    </div>

                </div>

                <div class="modal-action mt-8 border-t border-base-200 pt-6">
                    <button type="button" class="btn btn-ghost" onclick="avatar_modal.close()">Annuler</button>
                    <button type="submit" class="btn btn-primary px-8">Enregistrer</button>
                </div>
                {{ form_end(avatarForm) }}
            </div>

            <form method="dialog" class="modal-backdrop">
                <button>fermer</button>
            </form>
        </dialog>
    {% endif %}

{% endblock %}

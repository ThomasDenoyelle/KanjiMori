{% extends 'base.html.twig' %}

{% block title %}{{ vocabularySheet.title }} - Fiche de vocabulaire{% endblock %}

{% block body %}
    <div class="flex flex-col items-center w-full min-h-[70vh] p-4 lg:p-8">
        <div class="w-full max-w-5xl flex flex-col gap-6 bg-base-300 rounded-2xl shadow-sm border border-base-200">

            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 p-6 pb-2">
                <div class="flex flex-col gap-1">
                    <h1 class="text-3xl font-bold flex items-center gap-3">
                        <i class="fa-solid fa-book-open text-primary"></i>
                        <span>{{ vocabularySheet.title }}</span>
                    </h1>
                    <div class="flex items-center gap-2 text-sm text-base-content/70">
                        <span><i class="fa-solid fa-layer-group text-primary"></i> {{ vocabularySheet.items|length }} mot{{ vocabularySheet.items|length > 1 ? 's' : '' }}</span>
                        <span>•</span>
                        <span>Créée le {{ vocabularySheet.createdAt|date('d/m/Y') }}</span>
                    </div>
                </div>

            </div>

            <div class="px-6 pb-6">
                {% if vocabularySheet.items is empty %}
                    <div class="alert alert-info">
                        <i class="fa-solid fa-circle-info text-xl"></i>
                        <span>Cette fiche ne contient aucun mot pour le moment.</span>
                    </div>
                {% else %}
                    <ul class="list bg-base-100 rounded-box shadow-sm border border-base-200">
                        <li class="hidden sm:flex items-center p-4 py-3 border-b border-base-200 text-xs opacity-60 tracking-wide uppercase font-semibold">
                            <div class="w-8 shrink-0 text-center">#</div>
                            <div class="flex flex-1 items-center px-2">
                                <div class="flex-1 text-left">Mot / Kanji</div>
                                <div class="flex-1 text-center">Lecture (Hiragana)</div>
                                <div class="flex-1 text-right">Traduction</div>
                            </div>
                        </li>

                        {% for item in vocabularySheet.items %}
                            <li class="flex items-center p-4 gap-3 hover:bg-base-200/50 transition-colors border-b border-base-200 last:border-0">
                                <div class="w-8 shrink-0 text-xs font-semibold text-base-content/40 text-center">
                                    {{ loop.index }}
                                </div>

                                <div class="hidden sm:grid sm:grid-cols-3 w-full items-center px-2">
                                    <div class="text-lg font-bold text-base-content tracking-wide text-left">
                                        {{ item.kanji }}
                                    </div>
                                    <div class="text-lg font-semibold text-primary text-center">
                                        {{ item.reading }}
                                    </div>
                                    <div class="text-lg font-medium text-base-content/80 text-right">
                                        {{ item.translation ?: '-' }}
                                    </div>
                                </div>

                                <div class="flex sm:hidden justify-between items-center w-full gap-4 min-w-0">
                                    <div class="flex flex-col min-w-0">
                                        <span class="text-lg font-bold text-base-content tracking-wide truncate">
                                            {{ item.kanji }}
                                        </span>
                                        <span class="text-lg font-semibold text-primary truncate">
                                            {{ item.reading }}
                                        </span>
                                    </div>
                                    <div class="text-lg font-medium text-base-content/80 text-right shrink-0 max-w-[55%] break-words">
                                        {{ item.translation ?: '-' }}
                                    </div>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                <div class="flex flex-wrap gap-2 w-full sm:justify-end pt-4">
                    <a href="{{ path('library_vocabulary_list') }}" class="btn btn-ghost flex-1 sm:flex-none">
                        <i class="fa-solid fa-arrow-left"></i> Retour
                    </a>
                    <a href="{{ path('library_vocabulary_update', {vocabularySheet: vocabularySheet.id}) }}" class="btn btn-primary flex-1 sm:flex-none">
                        <i class="fa-solid fa-pen-to-square"></i> Modifier
                    </a>
                </div>
            </div>

        </div>
    </div>
{% endblock %}

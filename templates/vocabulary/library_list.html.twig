{% extends 'base.html.twig' %}

{% block title %}Mes fiches de vocabulaire{% endblock %}

{% block body %}
    <div class="flex flex-col items-center w-full min-h-[70vh] p-4 lg:p-8">
        <div class="w-full max-w-7xl flex flex-col gap-4">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4">
                <div class="flex flex-col gap-2">
                    <h1 class="text-4xl font-bold flex items-center gap-3">
                        <i class="fa-solid fa-book text-primary"></i> Mes fiches de vocabulaire
                    </h1>
                    <p class="text-base-content/70 text-lg">Créer, modifier, supprimer et consulter les fiches de vocabulaire !</p>
                </div>

                <div class="gap-2 flex">
                    <a href="{{ path('library_vocabulary_new') }}" class="btn btn-primary">
                        <i class="fa-solid fa-plus"></i> Créer une fiche
                    </a>
                    <button class="btn btn-primary shadow-sm" onclick="new_vocabulary_sheet_modal.showModal()">
                        <i class="fa-solid fa-file-circle-plus"></i> Générer une fiche
                    </button>
                </div>
            </div>

            <div class="divider mt-0"></div>

            {% if vocabularySheetList is empty %}
                <div class="alert alert-warning shadow-sm mt-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span>Vous n'avez aucune fiche de vocabulaire créée. <a href="" class="link link-primary">Créez-en une maintenant !</a></span>
                </div>
            {% else %}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

                    {{ include('vocabulary/_vocabulary_sheet_card.html.twig', {vocabularySheetList: vocabularySheetList}) }}

                </div>
            {% endif %}

        </div>
    </div>

    <dialog id="new_vocabulary_sheet_modal" class="modal modal-bottom sm:modal-middle">
        <div class="modal-box">
            <h3 class="font-bold text-2xl mb-6 flex items-center gap-3">
                <i class="fa-solid fa-file-circle-plus text-primary"></i> Générer une fiche
            </h3>

            <form action="{{ path('library_vocabulary_generate') }}" method="POST" data-turbo="false">
                <div class="mb-3">
                    <label for="japanese_text" class="block text-sm font-bold text-gray-700">Texte japonais</label>
                    <textarea id="japanese_text" name="japanese_text" rows="4" required placeholder="Colle ton texte japonais ici..."
                              class="mt-1 p-2 block w-full rounded-lg border-2 border-base-300 shadow-lg"></textarea>
                </div>
                <div class="modal-action mt-8">
                    <button type="button" class="btn btn-ghost" onclick="new_vocabulary_sheet_modal.close()">Annuler</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-check"></i> Créer
                    </button>
                </div>

            </form>


        </div>

        <form method="dialog" class="modal-backdrop">
            <button>Fermer</button>
        </form>
    </dialog>
{% endblock %}

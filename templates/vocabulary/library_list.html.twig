{% extends 'base.html.twig' %}

{% block title %}Mes fiches de vocabulaire{% endblock %}

{% block body %}
    <div class="flex flex-col items-center w-full min-h-[70vh] p-4 lg:p-8">
        <div class="w-full max-w-7xl flex flex-col gap-4">

            <div class="flex flex-col gap-2 text-center sm:text-left">
                <h1 class="text-4xl font-bold flex items-center gap-3 justify-center sm:justify-start">
                    <i class="fa-solid fa-book text-primary"></i> Mes fiches de vocabulaire
                </h1>
                <p class="text-base-content/70 text-lg">Créer, modifier, supprimer et consulter les fiches de vocabulaire !</p>
            </div>

            <div class="divider mt-0"></div>

            {% if vocabularySheetList is empty %}
                <div class="alert alert-warning shadow-sm mt-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span>Vous n'avez aucune fiche de vocabulaire créée. <a href="" class="link link-primary">Créez-en une maintenant !</a></span>
                </div>
            {% else %}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

                    {{ include('vocabulary/_vocabulary_sheet_card.html.twig', {vocabularySheetList: vocabularySheetList}) }}

                </div>
            {% endif %}

        </div>
    </div>
{% endblock %}

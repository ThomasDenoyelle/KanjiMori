{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center bg-base-200 p-4">
        <div class="card w-full max-w-sm shadow-2xl bg-base-100">
            <div class="card-body">
                <h1 class="card-title text-2xl font-bold justify-center mb-6">Connexion</h1>

                <form method="post">
                    {% if error %}
                        <div class="alert alert-error mb-4 text-sm shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                        </div>
                    {% endif %}

                    {% if app.user %}
                        <div class="alert alert-info mb-4 text-sm shadow-sm">
                            <span>Connecté en tant que {{ app.user.userIdentifier }}</span>
                            <a href="{{ logout_path() }}" class="btn btn-sm">Déconnexion</a>
                        </div>
                    {% endif %}

                    <div class="form-control mb-4">
                        <label for="username" class="label">
                            <span class="label-text">Adresse email</span>
                        </label>
                        <input type="email" value="{{ last_username }}" name="_username" id="username" class="input input-bordered w-full" autocomplete="email" required autofocus>
                    </div>

                    <div class="form-control mb-6">
                        <label for="password" class="label">
                            <span class="label-text">Mot de passe</span>
                        </label>
                        <input type="password" name="_password" id="password" class="input input-bordered w-full" autocomplete="current-password" required>
                    </div>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    <div class="form-control mt-2">
                        <button class="btn btn-primary w-full" type="submit">
                            Se connecter
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

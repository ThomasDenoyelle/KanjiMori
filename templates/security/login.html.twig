{% extends 'base.html.twig' %}

{% block title %}Connexion - Kanjis{% endblock %}

{% block body %}
    <div class="flex items-center justify-center w-full min-h-[70vh] p-4">

        <div class="card w-full max-w-md bg-base-300 shadow-xl">
            <div class="card-body">
                <h2 class="card-title text-2xl font-bold justify-center mb-4">Connexion</h2>

                <form method="post" class="flex flex-col gap-4" data-turbo="false">

                    {% if error %}
                        <div class="alert alert-error shadow-sm text-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                        </div>
                    {% endif %}

                    {% if app.user %}
                        <div class="alert alert-info shadow-sm text-sm">
                            <span>Connecté en tant que {{ app.user.userIdentifier }}</span>
                            <a href="{{ logout_path() }}" class="btn btn-sm btn-ghost">Déconnexion</a>
                        </div>
                    {% endif %}

                    <div class="form-control">
                        <label for="username" class="label">
                            <span class="label-text font-semibold">Adresse email</span>
                        </label>
                        <input type="email" value="{{ last_username }}" name="_username" id="username" class="input input-bordered w-full" autocomplete="email" required autofocus>
                    </div>

                    <div class="form-control">
                        <label for="password" class="label">
                            <span class="label-text font-semibold">Mot de passe</span>
                        </label>
                        <input type="password" name="_password" id="password" class="input input-bordered w-full" autocomplete="current-password" required>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="card-actions justify-end mt-4">
                        <button class="btn btn-primary w-full" type="submit">
                            Se connecter
                        </button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <a href="{{ path('app_register') }}" class="link link-hover text-sm text-base-content/70">Pas encore de compte ? Inscris-toi</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

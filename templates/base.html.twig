<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="flex flex-col min-h-screen font-nunito">
    <div class="navbar bg-base-100 shadow-sm">
        <div class="navbar-start">
            <a class="btn btn-ghost text-xl" href="{{ path('home') }}">{{ app_name }}</a>
        </div>
        <div class="navbar-end">
            <button class="btn sm:hidden" popovertarget="my-megamenu-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
                </svg>
            </button>

            <div class="megamenu max-sm:megamenu-vertical p-2 border-base-300" id="my-megamenu-1" popover>
                <span class="megamenu-active"></span>

                {% if app.user %}
                    <button popovertarget="a1">Quiz</button>
                    <div id="a1" popover>
                        <ul class="menu">
                            <li><a href="{{ path('quiz_list') }}"><i class="fa-solid fa-list"></i> Liste</a></li>
                            <li><a href="{{ path('quiz_new') }}"><i class="fa-solid fa-plus"></i> Créer</a></li>
                            <li><a><i class="fa-solid fa-folder"></i> Dossiers</a></li>
                            <li><a href="{{ path('game_history') }}"><i class="fa-solid fa-clock-rotate-left"></i> Historique</a></li>
                        </ul>
                    </div>
                {% endif %}

                <div class="px-2 flex gap-2">
                    {% if not app.user %}

                        {% set current_route = app.request.attributes.get('_route') %}

                        {% if current_route != 'app_login' %}
                            <a href="{{ path('app_login') }}" class="btn btn-primary">Connexion</a>
                        {% endif %}

                        {% if current_route != 'app_register' %}
                            <a href="{{ path('app_register') }}" class="btn btn-outline">Inscription</a>
                        {% endif %}

                    {% else %}
                        <div class="dropdown dropdown-end">
                            <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar placeholder">
                                <div class="bg-primary text-primary-content rounded-full w-10">
                                        <span class="font-bold">
                                            {% if app.user.firstname is defined and app.user.firstname %}
                                                {{ app.user.firstname|first|upper }}{{ app.user.lastname|first|upper }}
                                            {% else %}
                                                U
                                            {% endif %}
                                        </span>
                                </div>
                            </div>

                            <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
                                <li class="px-4 py-2 opacity-50 text-xs uppercase font-bold">
                                    {{ app.user.firstname }} {{ app.user.lastname }}
                                </li>
                                <li>
                                    <a href="{{ path('user_profil', {user: app.user.id}) }}" class="justify-between">
                                        Mon Profil
                                    </a>
                                </li>
                                <li><a href="{{ path('app_logout') }}" class="text-error">Déconnexion</a></li>
                            </ul>
                        </div>
                    {% endif %}
                </div>

            </div>
        </div>
    </div>
        {# -- navbar end -- #}

        {# -- flashbag -- #}
        <div class="toast toast-top toast-end z-50 mt-16">
            {% for label, messages in app.flashes %}

                {% set alert_class = 'alert-info' %}
                {% set icon = 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' %}

                {% if label == 'success' %}
                    {% set alert_class = 'alert-success text-success-content' %}
                    {% set icon = 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' %}
                {% elseif label == 'error' or label == 'danger' %}
                    {% set alert_class = 'alert-error text-error-content' %}
                    {% set icon = 'M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z' %}
                {% elseif label == 'warning' %}
                    {% set alert_class = 'alert-warning text-warning-content' %}
                    {% set icon = 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z' %}
                {% endif %}

                {% for message in messages %}
                    <div class="alert {{ alert_class }} shadow-lg mb-2 flex items-center transition-opacity duration-500 flash-message">
                        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ icon }}"></path></svg>
                        <span class="font-medium">{{ message }}</span>
                        <button class="btn btn-sm btn-ghost btn-circle ml-auto" onclick="this.closest('.alert').remove()">✕</button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
        {# -- flashbag end -- #}

        {# -- content -- #}
        <div class="container mx-auto p-2 bg-base grow">
            {% block body %}{% endblock %}
        </div>
        {# -- content end -- #}

        {# -- footer -- #}
        <footer class="bg-base-300 text-white flex justify-around items-center">
            <div>
                <p>{{ app_name }}</p>
            </div>
            <div>

            </div>
        </footer>
        {# -- footer end -- #}

    </body>
</html>

{% extends 'base.html.twig' %}

{% block title %}Résultat de votre quiz - {{ quizAttempt.quiz.title }} - {{ quizAttempt.mode == 'mode_kanji' ? 'Kanji' : (quizAttempt.mode == 'mode_reading' ? 'Lecture' : 'Traduction') }}{% endblock %}

{% block body %}
    <div class="flex items-center justify-center w-full min-h-[70vh] p-4">
        <div class="card w-full max-w-md bg-base-300 shadow-xl">
            <div class="card-body">
                <h1 class="card-title text-4xl font-bold justify-center">{{ quizAttempt.quiz.title }} - {{ quizAttempt.mode == 'mode_kanji' ? 'Kanji' : (quizAttempt.mode == 'mode_reading' ? 'Lecture' : 'Traduction') }}</h1>
                <p class="text-center text-base-content/70">Voici les résultats de votre quiz. <br> {{ quizAttempt.createdAt|date('d/m/Y H:i', 'Europe/Paris') }}</p>

                <div class="flex flex-col gap-4 mt-6">
                    <div class="flex justify-between items-center">
                        <div class="badge badge-soft badge-success">Connu : {{ quizAttempt.score }}</div>
                        <div class="badge badge-soft badge-error">Inconnu : {{ quizAttempt.maxScore - quizAttempt.score }}</div>
                    </div>
                    <div class="flex flex-col justify-between items-center gap-2">
                        {% set percentage = (quizAttempt.score / quizAttempt.maxScore) * 100 %}
                        <div class="radial-progress text-primary text-4xl" style="--value:{{ percentage }}; --size:12rem; --thickness: 1rem;" aria-valuenow="{{ percentage }}" role="progressbar">{{ percentage|round(0) }}%</div>
                        <span class="font-bold text-3xl text-primary">{{ quizAttempt.score }} / {{ quizAttempt.maxScore }}</span>
                    </div>
                </div>

            </div>
        </div>
    </div>
{% endblock %}

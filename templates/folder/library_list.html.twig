{% extends 'base.html.twig' %}

{% block title %}Mes dossiers{% endblock %}

{% block body %}
    <div class="flex flex-col items-center w-full min-h-[70vh] p-4 lg:p-8">
        <div class="w-full max-w-7xl flex flex-col gap-8">

            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4">
                <div class="flex flex-col gap-2">
                    <h1 class="text-4xl font-bold flex items-center gap-3">
                        <i class="fa-solid fa-folder-open text-primary"></i> Mes Dossiers
                    </h1>
                    <p class="text-base-content/70 text-lg">Organisez vos quiz et partagez-les avec vos classes.</p>
                </div>

                <button class="btn btn-primary shadow-sm" onclick="new_folder_modal.showModal()">
                    <i class="fa-solid fa-plus"></i> Nouveau dossier
                </button>
            </div>

            <div class="divider mt-0 mb-0"></div>

            {% if folderList is empty %}
                <div class="alert alert-info shadow-sm mt-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span>Vous n'avez pas encore créé de dossier pour le moment.</span>
                </div>
            {% else %}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-2">
                    {% for folder in folderList %}
                        <div class="card bg-base-300 shadow-xl border border-base-200 hover:border-primary/50 transition-colors flex flex-col">
                            <div class="card-body p-6 flex flex-col grow">

                                <div class="flex justify-between items-start gap-2 mb-2">
                                    <h2 class="card-title text-2xl truncate" title="{{ folder.title }}">
                                        {{ folder.title }}
                                    </h2>
                                    {% if folder.isPublic %}
                                        <div class="badge badge-success badge-sm gap-1 py-3 px-2 shadow-sm font-bold">
                                            <i class="fa-solid fa-globe text-xs"></i> Public
                                        </div>
                                    {% else %}
                                        <div class="badge badge-ghost badge-sm gap-1 py-3 px-2 shadow-sm font-bold opacity-70">
                                            <i class="fa-solid fa-lock text-xs"></i> Privé
                                        </div>
                                    {% endif %}
                                </div>

                                <p class="text-base-content/70 text-sm line-clamp-2 grow">
                                    {{ folder.description ?: 'Aucune description fournie.' }}
                                </p>

                                <div class="flex flex-wrap gap-2">
                                    <div class="badge badge-outline gap-2 font-medium">
                                        <i class="fa-solid fa-list-check"></i> {{ folder.quizzes|length }} quiz
                                    </div>

                                    {% if folder.isPublic %}
                                    <div class="badge badge-outline gap-2 font-medium">
                                        <i class="fa-solid fa-users"></i> {{ folder.members|length }} membre(s)
                                    </div>
                                    {% endif %}
                                </div>

                                <div class="card-actions justify-end mt-auto pt-4 border-t border-base-200/50 flex-nowrap">

                                    <a href="{{ path('library_folder_show', {'folder': folder.id}) }}" class="btn btn-sm btn-primary grow sm:grow-0">
                                        <i class="fa-solid fa-folder-open"></i> Ouvrir
                                    </a>

                                    <form method="post" action="{{ path('library_folder_delete', {'folder': folder.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce dossier ? Les quiz qu\'il contient ne seront pas supprimés de votre compte.');" class="inline-block">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_folder_' ~ folder.id) }}">
                                        <button class="btn btn-sm btn-circle btn-error" title="Supprimer le dossier">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>

                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

        </div>
    </div>



    <dialog id="new_folder_modal" class="modal modal-bottom sm:modal-middle">
        <div class="modal-box">
            <h3 class="font-bold text-2xl mb-6 flex items-center gap-3">
                <i class="fa-solid fa-folder-plus text-primary"></i> Créer un dossier
            </h3>

            {{ form_start(newFolderForm, {'action': path('library_folder_new')}) }}
            <div class="flex flex-col gap-4">

                <div class="form-control w-full">
                    {{ form_label(newFolderForm.title) }}
                    {{ form_widget(newFolderForm.title) }}
                    <div class="text-error text-sm mt-1">{{ form_errors(newFolderForm.title) }}</div>
                </div>

                <div class="form-control w-full">
                    {{ form_label(newFolderForm.description) }}
                    {{ form_widget(newFolderForm.description) }}
                    <div class="text-error text-sm mt-1">{{ form_errors(newFolderForm.description) }}</div>
                </div>

                <div class="form-control w-full mt-2">
                    <label class="label cursor-pointer justify-start gap-4">
                        {{ form_widget(newFolderForm.isPublic) }}
                        <span class="label-text font-semibold">Rendre ce dossier public (Partage)</span>
                    </label>
                    <div class="text-error text-sm mt-1">{{ form_errors(newFolderForm.isPublic) }}</div>
                </div>

            </div>

            <div class="modal-action mt-8">
                <button type="button" class="btn btn-ghost" onclick="new_folder_modal.close()">Annuler</button>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i> Créer
                </button>
            </div>
            {{ form_end(newFolderForm) }}
        </div>

        <form method="dialog" class="modal-backdrop">
            <button>Fermer</button>
        </form>
    </dialog>
{% endblock %}

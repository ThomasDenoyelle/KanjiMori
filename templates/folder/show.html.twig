{% extends 'base.html.twig' %}

{% block title %}{{ folder.title }} - Dossier{% endblock %}

{% block body %}
    <div class="flex flex-col items-center w-full min-h-[70vh] p-4 lg:p-8">
        <div class="w-full max-w-7xl flex flex-col gap-8">

            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 bg-base-300 p-6 rounded-3xl shadow-sm border border-base-200">
                <div class="flex flex-col gap-3">
                    <div class="flex items-center gap-3">
                        <h1 class="text-4xl font-bold flex items-center gap-3">
                            <i class="fa-solid fa-folder-open text-primary"></i> {{ folder.title }}
                        </h1>
                        <button class="btn btn-circle btn-primary btn-soft" onclick="update_folder_modal.showModal()">
                            <i class="fa-solid fa-pen-to-square text-3xl"></i>
                        </button>
                    </div>

                    <p class="text-base-content/80 text-lg max-w-3xl">
                        {{ folder.description ?: 'Aucune description pour ce dossier.' }}
                    </p>

                    <div class="flex flex-wrap gap-2 mt-1">
                        {% if folder.isPublic %}
                            <div class="badge badge-primary badge-sm gap-1 py-3 px-2 font-bold shadow-sm">
                                <i class="fa-solid fa-globe text-xs"></i> Partagé
                            </div>
                        {% else %}
                            <div class="badge badge-ghost badge-sm gap-1 py-3 px-2 font-bold opacity-70 shadow-sm">
                                <i class="fa-solid fa-lock text-xs"></i> Privé
                            </div>
                        {% endif %}
                        <div class="badge badge-outline gap-2 font-medium">
                            <i class="fa-solid fa-list-check"></i> {{ folder.quizzes|length }} quiz
                        </div>
                        {% if folder.isPublic %}
                            <div class="badge badge-outline gap-2 font-medium">
                                <i class="fa-solid fa-users"></i> {{ folder.members|length }} membre(s)
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="flex gap-2 w-full sm:w-auto mt-4 sm:mt-0">
                    <button class="btn btn-primary shadow-sm w-full sm:w-auto" onclick="manage_quizzes_modal.showModal()">
                        <i class="fa-solid fa-pen-to-square"></i> Gérer les quiz
                    </button>
                </div>
            </div>

            <div class="divider mt-0 mb-0">Contenu du dossier</div>

            {% if folder.quizzes is empty %}
                <div class="alert alert-info shadow-sm mt-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span>Ce dossier est vide. Cliquez sur "Gérer les quiz" pour commencer à le remplir !</span>
                </div>
            {% else %}
                <div class="flex flex-col gap-3 mt-2">
                    {% for quiz in folder.quizzes %}
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center p-4 bg-base-300 rounded-2xl shadow-sm border border-base-200 hover:border-primary/50 transition-colors gap-4 w-full">

                            <div class="flex flex-col gap-2 min-w-0 flex-1">
                                <h2 class="text-xl font-bold truncate" title="{{ quiz.title }}">
                                    {{ quiz.title }}
                                </h2>
                                <div class="flex items-center gap-2">
                                    <div class="badge badge-outline badge-sm font-medium gap-1">
                                        <i class="fa-solid fa-clipboard-question"></i> {{ quiz.questions|length }} questions
                                    </div>
                                    <span class="text-xs text-base-content/50">Créé le {{ quiz.createdAt|date('d/m/Y') }}</span>
                                </div>
                            </div>

                            <div class="flex-none w-full sm:w-auto">
                                <a href="{{ path('game_setup', {'quiz': quiz.id}) }}" class="btn btn-primary sm:btn-sm w-full">
                                    <i class="fa-solid fa-play"></i> Jouer
                                </a>
                            </div>

                        </div>
                    {% endfor %}
                </div>
            {% endif %}

        </div>
    </div>

    <dialog id="manage_quizzes_modal" class="modal modal-bottom sm:modal-middle">
        <div class="modal-box">
            <h3 class="font-bold text-2xl mb-6 flex items-center gap-3">
                <i class="fa-solid fa-list-check text-primary"></i> Gérer les quiz
            </h3>

            <div class="flex flex-col gap-2 max-h-96 overflow-y-auto pr-2">
                {% if quizList is empty %}
                    <p class="text-sm text-base-content/70 italic">Vous n'avez créé aucun quiz pour le moment.</p>
                {% else %}
                    {% for quiz in quizList %}
                        <turbo-frame id="quiz-toggle-{{ quiz.id }}">
                            <div class="flex justify-between items-center p-3 bg-base-100 rounded-xl border border-base-200">
                                <span class="font-bold truncate mr-2">{{ quiz.title }}</span>

                                <form method="post" action="{{ path('library_folder_toggle_quiz', {'folder': folder.id, 'quiz': quiz.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ folder.id ~ quiz.id) }}">

                                    {% if folder.quizzes.contains(quiz) %}
                                        <button type="submit" class="btn btn-sm btn-error btn-soft w-24">
                                            <i class="fa-solid fa-minus"></i> Retirer
                                        </button>
                                    {% else %}
                                        <button type="submit" class="btn btn-sm btn-success btn-soft w-24">
                                            <i class="fa-solid fa-plus"></i> Ajouter
                                        </button>
                                    {% endif %}
                                </form>
                            </div>
                        </turbo-frame>
                    {% endfor %}
                {% endif %}
            </div>

            <div class="modal-action mt-8">
                <a href="{{ path('library_folder_show', {'folder': folder.id}) }}" class="btn btn-primary" data-turbo="false">Terminer</a>
            </div>
        </div>

        <form method="dialog" class="modal-backdrop">
            <button>Fermer</button>
        </form>
    </dialog>

    <dialog id="update_folder_modal" class="modal modal-bottom sm:modal-middle">
        <div class="modal-box">
            <h3 class="font-bold text-2xl mb-6 flex items-center gap-3">
                <i class="fa-solid fa-folder-plus text-primary"></i> Créer aun dossier
            </h3>

            {{ form_start(updateFolderForm, {'action': path('library_folder_update', {'folder': folder.id})}) }}
            <div class="flex flex-col gap-4">

                <div class="form-control w-full">
                    {{ form_label(updateFolderForm.title) }}
                    {{ form_widget(updateFolderForm.title) }}
                    <div class="text-error text-sm mt-1">{{ form_errors(updateFolderForm.title) }}</div>
                </div>

                <div class="form-control w-full">
                    {{ form_label(updateFolderForm.description) }}
                    {{ form_widget(updateFolderForm.description) }}
                    <div class="text-error text-sm mt-1">{{ form_errors(updateFolderForm.description) }}</div>
                </div>

                <div class="form-control w-full mt-2">
                    <label class="label cursor-pointer justify-start gap-4">
                        {{ form_widget(updateFolderForm.isPublic) }}
                        <span class="label-text font-semibold">Rendre ce dossier partagé</span>
                    </label>
                    <div class="text-error text-sm mt-1">{{ form_errors(updateFolderForm.isPublic) }}</div>
                </div>

            </div>

            <div class="modal-action mt-8">
                <button type="button" class="btn btn-ghost" onclick="update_folder_modal.close()">Annuler</button>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i> Créer
                </button>
            </div>
            {{ form_end(updateFolderForm) }}
        </div>

        <form method="dialog" class="modal-backdrop">
            <button>Fermer</button>
        </form>
    </dialog>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Liste des feedbacks{% endblock %}

{% block body %}
    {% if feedbacksList is empty %}
        <div role="alert" class="alert alert-warning mt-5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span>Aucun feedback pour le moment !</span>
        </div>
    {% else %}
        <div class="overflow-x-auto rounded-box border-4 border-base-content/5 bg-base-300 mt-5" data-controller="datatable" data-datatable-title-value="Liste des feedbacks">
            <table class="table" id="feedback-list">

                <thead>
                <tr>
                    <th>Titre</th>
                    <th>Auteur</th>
                    <th>Date de création</th>
                    <th>Status</th>
                    <th></th>
                </tr>
                </thead>

                <tbody>
                {% for feedback in feedbacksList %}
                    <tr>
                        <td>{{ feedback.title|capitalize }}</td>
                        <td>{{ feedback.author.firstname }} {{ feedback.author.lastname }}</td>
                        <td>{{ feedback.createdAt|date('d/m/y H:i', 'Europe/Paris') }}</td>
                        <td>{{ feedback.valid ? 'Traité' : 'En cours' }}</td>
                        <td class="px-0">
                            <div class="gap-2 justify-end sm:flex hidden pe-4">
                                <a href="{{ path('feedback_show', {'feedback': feedback.id}) }}" class="btn btn-primary"><i class="fa-solid fa-eye"></i> Voir</a>
                            </div>

                            <div class="justify-end dropdown dropdown-left sm:hidden flex">
                                <div tabindex="0" role="button" class="btn m-1"><i class="fa-solid fa-bars"></i></div>
                                <ul tabindex="-1" class="dropdown-content menu bg-base-100 rounded-box z-1 w-52 gap-2 shadow-sm">
                                    <li>
                                        <a href="{{ path('feedback_show', {'feedback': feedback.id}) }}" class="btn btn-primary"><i class="fa-solid fa-eye"></i> Voir</a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>

            </table>
        </div>

    {% endif %}

{% endblock %}
